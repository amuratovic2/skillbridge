# PostgreSQL (Docker on port 5433 - does NOT touch your local Postgres on 5432)
DATABASE_URL=postgresql://skillbridge:skillbridge123@localhost:5433/skillbridge

# Security
JWT_SECRET=your-jwt-secret-change-in-production
GATEWAY_INTERNAL_SECRET=your-internal-gateway-secret-change-in-production
GATEWAY_SECURITY_ALLOW_SHARED_SECRET=true
GATEWAY_SIGNATURE_GATEWAY_ID=api-gateway
# Base64 PKCS#8 RSA private key for api-gateway only.
GATEWAY_SIGNATURE_PRIVATE_KEY=
# Matching Base64 X.509 RSA public key for user/gig/order/communication services.
GATEWAY_SIGNATURE_PUBLIC_KEY=

# Service Ports
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
GIG_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
COMM_SERVICE_PORT=3004

# Frontend
FRONTEND_URL=http://localhost:4200
