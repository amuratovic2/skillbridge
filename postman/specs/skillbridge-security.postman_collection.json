    {
      "name": "6 – Business Logic Errors (400)",
      "description": "Authenticated, correctly-authorized requests that violate business rules.",
      "item": [
        {
          "name": "6.1 Order Own Gig – CLIENT ordering their own gig → 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{freelancerToken}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"gigId\": {{gigId}} }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Note: This test uses the freelancer token but FREELANCERS cannot POST /orders (403 from gateway).",
                  "// To test self-order: log in as a user who is BOTH client AND owns a gig.",
                  "// The gateway blocks FREELANCER role on POST /orders (returns 403).",
                  "// If the user had CLIENT role and owned the gig, the service returns 400.",
                  "pm.test('Role error (403) or self-order error (400)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 Register Duplicate Email → 409",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_client_dup\",\n  \"email\": \"john.client@skillbridge.dev\",\n  \"password\": \"Password123!\",\n  \"role\": \"CLIENT\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Dup\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Duplicate email returns 409', () => pm.response.to.have.status(409));",
                  "pm.test('Conflict message returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6.3 Invalid Status Transition on Order → 400",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/orders/{{orderId}}/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"note\": \"Trying to skip to completed directly\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid transition returns 400', () => {",
                  "  // PENDING → COMPLETED is not a valid transition, should return 400",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 403]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
