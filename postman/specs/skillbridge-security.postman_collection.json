    {
      "name": "3 – Protected Resources – Happy Path",
      "description": "Authenticated requests with the correct role succeed.",
      "item": [
        {
          "name": "3.1 Create Gig – FREELANCER token → 201",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/gigs",
            "header": [
              { "key": "Authorization", "value": "Bearer {{freelancerToken}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"title\": \"Professional Web App\",\n  \"description\": \"Full-stack React + Spring Boot application\",\n  \"cost\": 299.99,\n  \"deliveryTime\": 7,\n  \"revisionCount\": 3,\n  \"tags\": [\"react\", \"spring-boot\"]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('FREELANCER can create gig – status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Gig data returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  if (body.data && body.data.id) pm.environment.set('gigId', body.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Place Order – CLIENT token → 200",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gigId\": {{gigId}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CLIENT can place order', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "if (pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  if (data && data.id) pm.environment.set('orderId', data.id);",
                  "}"
                ]
              }
            }
          ]
        },
