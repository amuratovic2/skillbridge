{
  "info": {
    "name": "Skillbridge – Security Documentation",
    "description": "Complete security flow: authentication, role-based authorization, error cases.\n\n**Setup:** Import `skillbridge-local` environment and run the requests in order. The login requests auto-save tokens to environment variables used by subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "1 – Authentication",
      "description": "Full authentication lifecycle: register, login (saves tokens), refresh, logout.",
      "item": [
        {
          "name": "1.1 Register – CLIENT",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testclient\",\n  \"email\": \"testclient@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"CLIENT\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Client\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns accessToken', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.data.accessToken).to.be.a('string');",
                  "  pm.environment.set('clientToken', body.data.accessToken);",
                  "  pm.environment.set('clientRefresh', body.data.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Register – FREELANCER",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testfreelancer\",\n  \"email\": \"testfreelancer@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"FREELANCER\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Freelancer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns accessToken', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.accessToken).to.be.a('string');",
                  "  pm.environment.set('freelancerToken', body.data.accessToken);",
                  "  pm.environment.set('freelancerRefresh', body.data.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Login – CLIENT (saves token)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.client@skillbridge.dev\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has both tokens', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.accessToken).to.be.a('string');",
                  "  pm.expect(data.refreshToken).to.be.a('string');",
                  "  pm.environment.set('clientToken', data.accessToken);",
                  "  pm.environment.set('clientRefresh', data.refreshToken);",
                  "  console.log('CLIENT token saved:', data.accessToken.substring(0,30) + '...');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Login – FREELANCER (saves token)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice.freelancer@skillbridge.dev\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has both tokens', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.environment.set('freelancerToken', data.accessToken);",
                  "  pm.environment.set('freelancerRefresh', data.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Login – ADMIN (saves token)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@skillbridge.dev\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Admin token saved', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.environment.set('adminToken', data.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{clientRefresh}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('New tokens issued', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.accessToken).to.be.a('string');",
                  "  pm.expect(data.refreshToken).to.be.a('string');",
                  "  pm.environment.set('clientToken', data.accessToken);",
                  "  pm.environment.set('clientRefresh', data.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.7 Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{clientRefresh}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Logout confirmed', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
