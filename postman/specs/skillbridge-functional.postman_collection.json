{
  "info": {
    "name": "SkillBridge Functional API",
    "description": "Comprehensive functional collection covering all 80 routes across auth, user, gig, order, communication services. Login request stores tokens in collection variables. Run sequentially or via Newman.\n\nDefault credentials (from seed data): marija@example.com / password123 (FREELANCER), ahmed@example.com / password123 (CLIENT), admin@skillbridge.ba / password123 (ADMIN).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "current_user_id", "value": "", "type": "string" },
    { "key": "freelancer_email", "value": "marija@example.com", "type": "string" },
    { "key": "freelancer_password", "value": "password123", "type": "string" },
    { "key": "client_email", "value": "ahmed@example.com", "type": "string" },
    { "key": "client_password", "value": "password123", "type": "string" },
    { "key": "admin_email", "value": "admin@skillbridge.ba", "type": "string" },
    { "key": "admin_password", "value": "password123", "type": "string" },
    { "key": "sample_gig_id", "value": "1", "type": "string" },
    { "key": "sample_user_id", "value": "2", "type": "string" },
    { "key": "sample_order_id", "value": "1", "type": "string" },
    { "key": "sample_category_id", "value": "1", "type": "string" },
    { "key": "sample_skill_id", "value": "1", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "Login as Freelancer (captures tokens)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{freelancer_email}}\",\n  \"password\": \"{{freelancer_password}}\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "if (json && json.data) {",
              "  if (json.data.accessToken) pm.collectionVariables.set('access_token', json.data.accessToken);",
              "  if (json.data.refreshToken) pm.collectionVariables.set('refresh_token', json.data.refreshToken);",
              "  if (json.data.user && json.data.user.id) pm.collectionVariables.set('current_user_id', json.data.user.id);",
              "}"
            ], "type": "text/javascript" }
          }]
        },
        {
          "name": "Login as Client",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{client_email}}\",\n  \"password\": \"{{client_password}}\"\n}" }
          }
        },
        {
          "name": "Login as Admin",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "POST /auth/register (CLIENT)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"newclient_{{$timestamp}}\",\n  \"email\": \"newclient_{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"CLIENT\",\n  \"firstName\": \"New\",\n  \"lastName\": \"Client\"\n}" }
          }
        },
        {
          "name": "POST /auth/register (FREELANCER)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"newfreelancer_{{$timestamp}}\",\n  \"email\": \"newfreelancer_{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"FREELANCER\",\n  \"firstName\": \"New\",\n  \"lastName\": \"Freelancer\"\n}" }
          }
        },
        {
          "name": "[NEG] POST /auth/register (invalid role) → 400",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"bad_{{$timestamp}}\",\n  \"email\": \"bad_{{$timestamp}}@x.com\",\n  \"password\": \"password123\",\n  \"role\": \"NONSENSE\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 on invalid role', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }]
        },
        {
          "name": "[NEG] POST /auth/register (duplicate email) → 409",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"dupe\",\n  \"email\": \"{{freelancer_email}}\",\n  \"password\": \"password123\",\n  \"role\": \"CLIENT\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 on duplicate', () => pm.response.to.have.status(409));"], "type": "text/javascript" } }]
        },
        {
          "name": "POST /auth/login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{freelancer_email}}\",\n  \"password\": \"{{freelancer_password}}\"\n}" }
          }
        },
        {
          "name": "[NEG] POST /auth/login (wrong password) → 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{freelancer_email}}\",\n  \"password\": \"wrong\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 on wrong password', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }]
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" }
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" }
          }
        },
        {
          "name": "POST /auth/validate",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/validate", "host": ["{{base_url}}"], "path": ["auth", "validate"] },
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{access_token}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "02 - Users",
      "item": [
        {
          "name": "GET /users/me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "[NEG] GET /users/me (no auth) → 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 without auth', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }]
        },
        {
          "name": "GET /users/{id}",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/{{sample_user_id}}", "host": ["{{base_url}}"], "path": ["users", "{{sample_user_id}}"] }
          }
        },
        {
          "name": "[NEG] GET /users/99999 → 404",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/99999", "host": ["{{base_url}}"], "path": ["users", "99999"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 on missing user', () => pm.response.to.have.status(404));"], "type": "text/javascript" } }]
        },
        {
          "name": "PATCH /users/me (JSON body)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] },
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Name\",\n  \"bio\": \"Updated bio\",\n  \"country\": \"Bosna i Hercegovina\"\n}" }
          }
        },
        {
          "name": "PATCH /users/me (JSON-Patch)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json-patch+json" }],
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] },
            "body": { "mode": "raw", "raw": "[\n  { \"op\": \"replace\", \"path\": \"/bio\", \"value\": \"Patched via JSON-Patch\" }\n]" }
          }
        },
        {
          "name": "DELETE /users/me",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] }
          }
        }
      ]
    },
    {
      "name": "03 - Skills",
      "item": [
        {
          "name": "GET /skills",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/skills", "host": ["{{base_url}}"], "path": ["skills"] } }
        },
        {
          "name": "POST /skills/batch",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/skills/batch", "host": ["{{base_url}}"], "path": ["skills", "batch"] },
            "body": { "mode": "raw", "raw": "{ \"ids\": [1, 2, 3] }" }
          }
        },
        {
          "name": "GET /skills/user/{userId}",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/skills/user/{{sample_user_id}}", "host": ["{{base_url}}"], "path": ["skills", "user", "{{sample_user_id}}"] } }
        },
        {
          "name": "POST /skills/me/{skillId} (add skill to me)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/skills/me/{{sample_skill_id}}", "host": ["{{base_url}}"], "path": ["skills", "me", "{{sample_skill_id}}"] }
          }
        },
        {
          "name": "PUT /skills/me (replace my skills)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/skills/me", "host": ["{{base_url}}"], "path": ["skills", "me"] },
            "body": { "mode": "raw", "raw": "{ \"skillIds\": [1, 2, 5] }" }
          }
        },
        {
          "name": "DELETE /skills/me/{skillId}",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/skills/me/{{sample_skill_id}}", "host": ["{{base_url}}"], "path": ["skills", "me", "{{sample_skill_id}}"] }
          }
        }
      ]
    },
    {
      "name": "04 - Portfolios",
      "item": [
        {
          "name": "GET /portfolios/user/{userId}",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/portfolios/user/{{sample_user_id}}", "host": ["{{base_url}}"], "path": ["portfolios", "user", "{{sample_user_id}}"] } }
        },
        {
          "name": "POST /portfolios",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/portfolios", "host": ["{{base_url}}"], "path": ["portfolios"] },
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Portfolio item via Postman\",\n  \"description\": \"Generated for testing\",\n  \"imageUrl\": null\n}" }
          }
        },
        {
          "name": "POST /portfolios/batch",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/portfolios/batch", "host": ["{{base_url}}"], "path": ["portfolios", "batch"] },
            "body": { "mode": "raw", "raw": "{ \"userIds\": [2, 3, 4] }" }
          }
        },
        {
          "name": "PATCH /portfolios/{id}",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/portfolios/1", "host": ["{{base_url}}"], "path": ["portfolios", "1"] },
            "body": { "mode": "raw", "raw": "{ \"description\": \"Patched description\" }" }
          }
        },
        {
          "name": "DELETE /portfolios/{id}",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/portfolios/9999", "host": ["{{base_url}}"], "path": ["portfolios", "9999"] }
          }
        }
      ]
    },
    {
      "name": "05 - Categories",
      "item": [
        {
          "name": "GET /categories",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] } }
        },
        {
          "name": "POST /categories (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] },
            "body": { "mode": "raw", "raw": "{ \"title\": \"Test Category {{$timestamp}}\", \"slug\": \"test-category-{{$timestamp}}\" }" }
          }
        },
        {
          "name": "GET /categories/{slug}",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{base_url}}/categories/graficki-dizajn", "host": ["{{base_url}}"], "path": ["categories", "graficki-dizajn"] } }
        },
        {
          "name": "PATCH /categories/{id}",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/categories/{{sample_category_id}}", "host": ["{{base_url}}"], "path": ["categories", "{{sample_category_id}}"] },
            "body": { "mode": "raw", "raw": "{ \"title\": \"Updated Title\" }" }
          }
        },
        {
          "name": "DELETE /categories/{id}",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/categories/9999", "host": ["{{base_url}}"], "path": ["categories", "9999"] }
          }
        }
      ]
    },
    {
      "name": "06 - Tags",
      "item": [
        {
          "name": "GET /tags",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{base_url}}/tags", "host": ["{{base_url}}"], "path": ["tags"] } }
        },
        {
          "name": "GET /tags/popular",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{base_url}}/tags/popular?limit=10", "host": ["{{base_url}}"], "path": ["tags", "popular"], "query": [{ "key": "limit", "value": "10" }] } }
        }
      ]
    },
    {
      "name": "07 - Gigs",
      "item": [
        {
          "name": "POST /gigs (create)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/gigs", "host": ["{{base_url}}"], "path": ["gigs"] },
            "body": { "mode": "raw", "raw": "{\n  \"categoryId\": 1,\n  \"title\": \"Test gig {{$timestamp}}\",\n  \"description\": \"Created via Postman\",\n  \"cost\": 75.00,\n  \"deliveryTime\": 5,\n  \"revisionCount\": 2,\n  \"coverImage\": null,\n  \"tags\": [\"Logo\"]\n}" }
          }
        },
