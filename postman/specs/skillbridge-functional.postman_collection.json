        {
          "name": "GET /orders/{id}",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/orders/{{sample_order_id}}", "host": ["{{base_url}}"], "path": ["orders", "{{sample_order_id}}"] } }
