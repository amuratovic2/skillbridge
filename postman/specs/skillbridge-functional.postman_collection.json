          "name": "GET /gigs/search",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{base_url}}/gigs/search?page=1&limit=12", "host": ["{{base_url}}"], "path": ["gigs", "search"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "12" }] } }
        },
        {
          "name": "GET /gigs/search (filtered)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{base_url}}/gigs/search?q=logo&categoryId=1&minPrice=10&maxPrice=200&sortBy=newest", "host": ["{{base_url}}"], "path": ["gigs", "search"], "query": [{ "key": "q", "value": "logo" }, { "key": "categoryId", "value": "1" }, { "key": "minPrice", "value": "10" }, { "key": "maxPrice", "value": "200" }, { "key": "sortBy", "value": "newest" }] } }
        },
        {
          "name": "GET /gigs/featured",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{base_url}}/gigs/featured?limit=6", "host": ["{{base_url}}"], "path": ["gigs", "featured"], "query": [{ "key": "limit", "value": "6" }] } }
        },
        {
          "name": "GET /gigs/freelancer/{freelancerId}",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{base_url}}/gigs/freelancer/{{sample_user_id}}", "host": ["{{base_url}}"], "path": ["gigs", "freelancer", "{{sample_user_id}}"] } }
        },
        {
          "name": "GET /gigs/{id}",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{base_url}}/gigs/{{sample_gig_id}}", "host": ["{{base_url}}"], "path": ["gigs", "{{sample_gig_id}}"] } }
        },
        {
          "name": "[NEG] GET /gigs/99999 → 404",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{base_url}}/gigs/99999", "host": ["{{base_url}}"], "path": ["gigs", "99999"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 on missing gig', () => pm.response.to.have.status(404));"], "type": "text/javascript" } }]
        },
        {
          "name": "PATCH /gigs/{id}",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/gigs/{{sample_gig_id}}", "host": ["{{base_url}}"], "path": ["gigs", "{{sample_gig_id}}"] },
            "body": { "mode": "raw", "raw": "{ \"description\": \"Updated description\" }" }
          }
        },
        {
          "name": "DELETE /gigs/{id}",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/gigs/9999", "host": ["{{base_url}}"], "path": ["gigs", "9999"] }
          }
        }
      ]
    },
    {
      "name": "08 - Orders",
      "item": [
        {
          "name": "POST /orders (create)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/orders", "host": ["{{base_url}}"], "path": ["orders"] },
            "body": { "mode": "raw", "raw": "{\n  \"gigId\": {{sample_gig_id}},\n  \"requirements\": \"Test order from Postman\"\n}" }
          }
        },
        {
          "name": "POST /orders/batch",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/orders/batch", "host": ["{{base_url}}"], "path": ["orders", "batch"] },
